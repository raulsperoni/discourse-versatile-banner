{{#if this.shouldShow}}
  {{#unless this.bannerClosed}}
    <div class="banner-box" {{did-insert this.didInsertCarousel}}>
      <div class="container">
        <div class="button-container">
          {{#if (theme-setting "dismissible")}}
            <DButton
              @action={{this.closeBanner}}
              @translatedLabel={{theme-i18n "close.label"}}
              @translatedTitle={{theme-i18n "close.title"}}
              @icon="xmark"
              class="close"
            />
          {{/if}}
          {{#if (theme-setting "collapsible")}}
            <DButton
              @action={{this.toggleBanner}}
              @translatedLabel={{this.toggleLabel}}
              @translatedTitle={{theme-i18n "toggle.title"}}
              @icon={{this.toggleIcon}}
              class="toggle"
            />
          {{/if}}
        </div>
        <div
          id="banner-content_wrap"
          class={{if
            (and (theme-setting "collapsible") this.bannerCollapsed)
            "--banner-collapsed"
          }}
        >
          <div class="banner-carousel-container">
            <div class="carousel" id="versatile-carousel">
              {{#if this.showCarouselControls}}
                <button class="carousel-btn prev" type="button" aria-label="Previous slide">&#10094;</button>
              {{/if}}
              <div class="carousel-track">
                {{#each this.bannerSlides as |slide index|}}
                  <div class="carousel-slide{{if (eq index 0) ' active'}}">
                    <div class="banner-content">
                      <p>Slide {{slide.index}} - Content Image: {{slide.contentImage}}</p>
                      {{#if slide.contentImage}}
                        <img data-asset-key="{{slide.contentImage}}" alt="{{slide.contentImageAlt}}" class="banner-main-image" />
                      {{/if}}
                    </div>
                  </div>
                {{/each}}
              </div>
              {{#if this.showCarouselControls}}
                <button class="carousel-btn next" type="button" aria-label="Next slide">&#10095;</button>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
  {{/unless}}
{{/if}}