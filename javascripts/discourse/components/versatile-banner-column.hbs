{{#if (or @columnContent (and @categoryTitle @categoryIcon @categoryAbout))}}
  <div class="{{@columnClass}} single-box">
    {{#if (and (or @categoryTitle @categoryIcon @categoryAbout) (not @columnContent))}}
      <div class="category-info">
        {{#if @categoryIcon}}
          <span class="category-icon">
            {{#if (this.isHttpLink @categoryIcon)}}
              <img class="responsive-img" src={{@categoryIcon}} alt="Category Icon" />
            {{else if (this.isColorCode @categoryIcon)}}
              <span class="color-dot" style="display:inline-block;width:18px;height:18px;border-radius:50%;background:{{@categoryIcon}};"></span>
            {{else if (this.isIconString @categoryIcon)}}
              {{d-icon @categoryIcon}}
            {{/if}}
          </span>
        {{/if}}
        {{#if @categoryTitle}}
          <h3 class="category-title">{{@categoryTitle}}</h3>
        {{/if}}
        {{#if @categoryAbout}}
          <p class="category-about">{{html-safe @categoryAbout}}</p>
        {{/if}}
      </div>
    {{else if @columnContent}}
      <div>
        {{html-safe @columnContent}}
      </div>
    {{/if}}
  </div>
{{/if}}